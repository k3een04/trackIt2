{
  "functions": {
    "api/index.js": {
      "includeFiles": "{visuals/**,vendor/**,*.html,*.js,*.css,*.png,*.jpg,*.svg,*.pdf}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ]
}


