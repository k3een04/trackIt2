# TrackIT backend environment
# Copy this file to backend/.env and fill in the real values.
# backend/.env is gitignored - never commit real secrets.

# Database + server
MONGODB_URI=mongodb://localhost:27017
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string

# School email domain(s) accepted for student/coordinator signup
STI_EMAIL_DOMAINS=wnu.sti.edu.ph

# Optional AI summary provider
OPENROUTER_API_KEY=

# Which mail transport to use: smtp | graph | auto (default auto = smtp, then graph)
MAIL_TRANSPORT=auto

# --- SMTP: send from a real mailbox (school Microsoft 365 account, Gmail, ...) ---
# Ready-to-paste presets with a free relay:
#
#   Local dev mailbox (no signup): run `npm run devmailbox` in backend/, then use
#     SMTP_HOST=127.0.0.1
#     SMTP_PORT=2525
#     SMTP_REQUIRE_TLS=false
#     SMTP_FROM=no-reply@wnu.sti.edu.ph
#     (leave SMTP_USER / SMTP_PASS empty; read the mail at http://localhost:2526)
#
#   Mailtrap sandbox:  SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525
#                      SMTP_USER=<sandbox user>          SMTP_PASS=<sandbox password>
#
#   Brevo:             SMTP_HOST=smtp-relay.brevo.com     SMTP_PORT=587
#                      SMTP_USER=<bb1234567@smtp-brevo.com> SMTP_PASS=<SMTP key>
#                      SMTP_USER is the dedicated relay login from Brevo > SMTP & API,
#                      NOT the account email. Also note: if the account has IP
#                      protection enabled, allowlist the sending server's public IP at
#                      https://app.brevo.com/security/authorised_ips or the relay
#                      answers "525 Unauthorized IP address".
#
#   School Microsoft 365 mailbox: SMTP_HOST=smtp.office365.com SMTP_PORT=587
#                      SMTP_AUTH must be enabled for the mailbox and an app
#                      password is needed when MFA is on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=TrackIT

# --- Microsoft Graph: app-only send, no mailbox password (Azure AD app with the
#     application permission Mail.Send + admin consent) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=no-reply@wnu.sti.edu.ph
MS_SENDER_NAME=TrackIT
