# TrackIT backend environment
# Copy this file to backend/.env and fill in the real values.
# backend/.env is gitignored - never commit real secrets.

# Database + server
MONGODB_URI=mongodb://localhost:27017
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string

# School email domain(s) accepted for student/coordinator signup
STI_EMAIL_DOMAINS=wnu.sti.edu.ph

# Optional AI summary provider
OPENROUTER_API_KEY=

# Microsoft Graph mail - used to email the forgot-password code.
# Azure AD app registration with the application permission Mail.Send
# (admin consent granted + Application Access Policy for the sender mailbox).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=no-reply@wnu.sti.edu.ph
MS_SENDER_NAME=TrackIT
